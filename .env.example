# SmartExam AI - Environment Configuration Example

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL="postgresql://smartexam_user:smartexam_password@localhost:5432/smartexam_db"

# Authentication & JWT
JWT_SECRET="replace-with-a-random-32-byte-hex-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="120"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://smartexam-ai.vercel.app"

# API & Frontend URLs
VITE_API_BASE_URL="http://localhost:3000"
VITE_WS_BASE_URL="ws://localhost:3000"
APP_URL="http://localhost:3000"

# ML Model Configuration
MODEL_PATH="./ml/models/baseline_weights.json"
DATASET_PATH="./ml/data/synthetic_behavioral_dataset.csv"
